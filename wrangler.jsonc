{
	"name": "dog-cafe-assistant",
	"main": "src/index.ts",
	"workers_dev": true,
	"preview_urls": false,
	"compatibility_date": "2026-10-01",
	// 글자 얹기(resvg)는 CPU를 많이 써서 작업당 CPU 시간을 넉넉히 준다. (Workers Paid 필요)
	"limits": { "cpu_ms": 60000 },
	"compatibility_flags": [
		"nodejs_compat"
	],
	"r2_buckets": [
		{
			"binding": "BUCKET",
			"bucket_name": "dog-cafe-assistant"
		}
	],
	"queues": {
  "producers": [{ "binding": "JOBS", "queue": "dog-cafe-jobs" }],
  "consumers": [
    {
      "queue": "dog-cafe-jobs",
      "max_batch_size": 1,   // 작업 하나씩 바로 처리
      "max_retries": 0       // 실패해도 다시 만들지 않는다 (비용이 두 번 들고, 콜백 주소는 한 번만 쓸 수 있음)
    }
  ]
	},
	// 매일 UTC 0시 = 한국 시간 오전 9시에 기념일 안내 에이전트를 실행한다.
	"triggers": { "crons": ["0 0 * * *"] },
	"vars": {
		"OPENAI_IMAGE_MODEL": "gpt-image-2",
		"OPENAI_DESIGN_MODEL": "gpt-5-mini",
		"STORE_NAME": "",
		// 테스트 모드: 허용 목록에 없는 사람도 하루 KAKAO_TEST_DAILY_LIMIT번까지 쓸 수 있다. 심사가 끝나면 "false"로.
		"KAKAO_OPEN_TEST": "true",
		"KAKAO_TEST_DAILY_LIMIT": "5",
		"PUBLIC_ORIGIN": "https://dog-cafe-assistant.thigma1201.workers.dev",
		"KAKAO_CHANNEL_CHAT_URL": "http://pf.kakao.com/_QfJxeX/chat",
		"REMINDER_DRY_RUN": "false",
		"FONT_URL": "https://cdn.jsdelivr.net/npm/pretendard@1.3.9/dist/public/static/Pretendard-Bold.otf"
	}
}
