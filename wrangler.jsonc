{
	"name": "dog-cafe-assistant",
	"main": "src/index.ts",
	"workers_dev": true,
	"preview_urls": false,
	"compatibility_date": "2026-10-01",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"r2_buckets": [
		{
			"binding": "BUCKET",
			"bucket_name": "dog-cafe-assistant"
		}
	],
	"vars": {
		"OPENAI_IMAGE_MODEL": "gpt-image-2",
		"OPENAI_DESIGN_MODEL": "gpt-5-mini",
		"STORE_NAME": "",
		"FONT_URL": "https://cdn.jsdelivr.net/npm/pretendard@1.3.9/dist/public/static/Pretendard-Bold.otf"
	}
}
